// Nexora — esquema relacional (PostgreSQL)
//
// Principios:
// - Multiempresa desde el día uno: toda tabla de negocio lleva company_id.
//   Las relaciones críticas usan claves foráneas compuestas (id, company_id),
//   así la base de datos impide enlazar un registro con una sede o empleado de
//   otra empresa aunque el código tuviera un error.
// - El tiempo real nunca se borra: attendance_event y audit_log son de solo
//   inserción (lo garantiza un trigger en la migración). Las correcciones se
//   registran como eventos nuevos que referencian al original.
// - Una sola jornada abierta por empleado: índice único parcial en
//   work_session (ver migración).
// - Los parámetros laborales están versionados por fecha y citan su fuente.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ───────────────────────────── Enumeraciones ─────────────────────────────

enum Role {
  SUPERADMIN
  COMPANY_ADMIN
  EMPLOYEE
}

enum CompanyStatus {
  TRIAL
  ACTIVE
  SUSPENDED
}

enum EmployeeStatus {
  ACTIVE
  INACTIVE
}

enum DocumentType {
  CC
  CE
  PPT
  PASAPORTE
  TI
}

enum ContractType {
  INDEFINIDO
  FIJO
  OBRA_LABOR
  APRENDIZAJE
  PRESTACION_SERVICIOS
}

enum SalaryType {
  ORDINARIO
  INTEGRAL
}

enum PayFrequency {
  QUINCENAL
  MENSUAL
}

enum ArlRiskClass {
  I
  II
  III
  IV
  V
}

enum DeviceStatus {
  PENDING
  ACTIVE
  REVOKED
}

enum PunchType {
  IN
  OUT
  BREAK_START
  BREAK_END
}

enum PunchSource {
  QR
  ADMIN_MANUAL
  SYSTEM
}

enum GeoStatus {
  INSIDE
  OUTSIDE
  LOW_ACCURACY
  UNAVAILABLE
  NOT_REQUIRED
}

enum VerificationMethod {
  PASSKEY
  DEVICE_TOKEN
  ADMIN
}

enum PunchStatus {
  ACCEPTED
  FLAGGED
}

enum AttemptReason {
  OUTSIDE_RADIUS
  LOW_ACCURACY
  LOCATION_DENIED
  DEVICE_NOT_BOUND
  DEVICE_REVOKED
  INVALID_QR
  QR_REVOKED
  WRONG_COMPANY
  DUPLICATE_PUNCH
  NO_OPEN_SESSION
  RATE_LIMITED
  PASSKEY_FAILED
  OTHER
}

enum WorkSessionStatus {
  OPEN
  CLOSED
  NEEDS_REVIEW
}

enum ShiftStatus {
  PLANNED
  CANCELLED
}

enum RequestStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

enum NoveltyType {
  VACACIONES
  INCAPACIDAD_COMUN
  INCAPACIDAD_LABORAL
  LICENCIA_MATERNIDAD
  LICENCIA_PATERNIDAD
  LICENCIA_REMUNERADA
  LICENCIA_NO_REMUNERADA
  LICENCIA_LUTO
  CALAMIDAD_DOMESTICA
  PERMISO
  AUSENCIA_INJUSTIFICADA
  SUSPENSION
}

enum ParameterUnit {
  COP
  PERCENT
  HOURS
  MINUTES
  TIME_OF_DAY
  DAYS
  COUNT
}

enum PayrollStatus {
  DRAFT
  REVIEWED
  CLOSED
}

// ─────────────────────────── Empresas y usuarios ──────────────────────────

model Company {
  id                   String        @id @default(uuid(7)) @db.Uuid
  name                 String
  legalName            String?       @map("legal_name")
  nit                  String?
  slug                 String        @unique
  timezone             String        @default("America/Bogota")
  status               CompanyStatus @default(TRIAL)
  // Preparación SaaS (sin cobro todavía)
  planCode             String?       @map("plan_code")
  maxEmployees         Int?          @map("max_employees")
  maxSites             Int?          @map("max_sites")
  // Reglas operativas de la empresa
  lateToleranceMin     Int           @default(5) @map("late_tolerance_min")
  geoMaxAccuracyM      Int           @default(100) @map("geo_max_accuracy_m")
  requireDeviceBinding Boolean       @default(true) @map("require_device_binding")
  // Exoneración de salud del empleador, SENA e ICBF (art. 114-1 E.T.).
  parafiscalExempt     Boolean       @default(false) @map("parafiscal_exempt")
  createdAt            DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt            DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)

  users              User[]
  sites              Site[]
  employees          Employee[]
  devices            DeviceBinding[]
  shiftTemplates     ShiftTemplate[]
  schedulePatterns   SchedulePattern[]
  scheduledShifts    ScheduledShift[]
  attendanceEvents   AttendanceEvent[]
  attendanceAttempts AttendanceAttempt[]
  workSessions       WorkSession[]
  overtimeRequests   OvertimeRequest[]
  novelties          Novelty[]
  holidays           Holiday[]
  laborParameters    LaborParameter[]
  payrollPeriods     PayrollPeriod[]
  payrollEstimates   PayrollEstimate[]
  auditLogs          AuditLog[]
  qrCodes            SiteQrCode[]
  contracts          EmployeeContract[]
  integrations       Integration[]
  products           Product[]
  stockMovements     StockMovement[]
  cashMovements      CashMovement[]
  cashClosings       CashClosing[]
  customers          Customer[]
  sales              Sale[]
  deals              Deal[]
  crmActivities      CrmActivity[]
  conversations      Conversation[]
  messages           Message[]
  crmAiConfig        CrmAiConfig?
  aiGaps             AiGap[]
  waTemplates        WaTemplate[]
  socialComments     SocialComment[]
  appointments       Appointment[]
  aiVersions         CrmAiVersion[]
  posCategories      PosCategory[]
  invitation         CompanyInvitation?

  @@map("company")
}

model User {
  id                 String    @id @default(uuid(7)) @db.Uuid
  companyId          String?   @map("company_id") @db.Uuid
  email              String    @unique
  name               String
  passwordHash       String    @map("password_hash")
  role               Role
  active             Boolean   @default(true)
  mustChangePassword Boolean   @default(false) @map("must_change_password")
  failedLogins       Int       @default(0) @map("failed_logins")
  lockedUntil        DateTime? @map("locked_until") @db.Timestamptz(3)
  lastLoginAt        DateTime? @map("last_login_at") @db.Timestamptz(3)
  createdAt          DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  company            Company?            @relation(fields: [companyId], references: [id], onDelete: Restrict)
  employee           Employee?
  sessions           Session[]
  passkeys           PasskeyCredential[]
  consents           DataConsent[]
  managedSites       Site[]              @relation("SiteManager")
  auditLogs          AuditLog[]          @relation("AuditActor")
  decidedOvertime    OvertimeRequest[]   @relation("OvertimeDecider")
  decidedNovelties   Novelty[]           @relation("NoveltyDecider")
  requestedNovelties Novelty[]           @relation("NoveltyRequester")
  manualPunches      AttendanceEvent[]   @relation("PunchCreatedBy")
  stockMovements     StockMovement[]     @relation("StockMovementBy")
  cashMovements      CashMovement[]      @relation("CashMovementBy")
  cashVoids          CashMovement[]      @relation("CashMovementVoidedBy")
  cashClosings       CashClosing[]       @relation("CashClosingBy")
  cashReopenings     CashClosing[]       @relation("CashClosingReopenedBy")
  sales              Sale[]              @relation("SaleBy")
  voidedSales        Sale[]              @relation("SaleVoidedBy")
  ownedDeals         Deal[]              @relation("DealOwner")
  crmActivities      CrmActivity[]       @relation("CrmActivityBy")
  sentMessages       Message[]           @relation("MessageSentBy")

  @@index([companyId, role])
  @@map("app_user")
}

model Session {
  // id = SHA-256 del token de la cookie; el token en claro nunca se guarda.
  id              String   @id
  userId          String   @map("user_id") @db.Uuid
  deviceBindingId String?  @map("device_binding_id") @db.Uuid
  expiresAt       DateTime @map("expires_at") @db.Timestamptz(3)
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  lastSeenAt      DateTime @default(now()) @map("last_seen_at") @db.Timestamptz(3)
  userAgent       String?  @map("user_agent")
  // Desafío WebAuthn en curso (registro o verificación de passkey); de un solo uso y corta vida.
  webauthnChallenge        String?   @map("webauthn_challenge")
  webauthnChallengeExpires DateTime? @map("webauthn_challenge_expires") @db.Timestamptz(3)

  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  deviceBinding DeviceBinding? @relation(fields: [deviceBindingId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([expiresAt])
  @@map("session")
}

model PasskeyCredential {
  id              String    @id @default(uuid(7)) @db.Uuid
  userId          String    @map("user_id") @db.Uuid
  deviceBindingId String?   @map("device_binding_id") @db.Uuid
  credentialId    String    @unique @map("credential_id") // base64url
  publicKey       Bytes     @map("public_key")
  counter         BigInt    @default(0)
  transports      String[]  @default([])
  name            String?
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  lastUsedAt      DateTime? @map("last_used_at") @db.Timestamptz(3)

  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  deviceBinding DeviceBinding? @relation(fields: [deviceBindingId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@map("passkey_credential")
}

// Autorización de tratamiento de datos (Ley 1581 de 2012).
model DataConsent {
  id            String   @id @default(uuid(7)) @db.Uuid
  userId        String   @map("user_id") @db.Uuid
  policyVersion String   @map("policy_version")
  acceptedAt    DateTime @default(now()) @map("accepted_at") @db.Timestamptz(3)
  userAgent     String?  @map("user_agent")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, policyVersion])
  @@map("data_consent")
}

// ───────────────────────────────── Sedes ─────────────────────────────────

model Site {
  id            String   @id @default(uuid(7)) @db.Uuid
  companyId     String   @map("company_id") @db.Uuid
  name          String
  address       String
  city          String
  latitude      Decimal  @db.Decimal(9, 6)
  longitude     Decimal  @db.Decimal(9, 6)
  radiusMeters  Int      @default(80) @map("radius_meters")
  managerUserId String?  @map("manager_user_id") @db.Uuid
  active        Boolean  @default(true)
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  company          Company              @relation(fields: [companyId], references: [id], onDelete: Restrict)
  manager          User?                @relation("SiteManager", fields: [managerUserId], references: [id], onDelete: SetNull)
  openingHours     SiteOpeningHours[]
  qrCodes          SiteQrCode[]
  employeesDefault Employee[]
  shifts           ScheduledShift[]
  patternDays      SchedulePatternDay[]
  events           AttendanceEvent[]
  sessions         WorkSession[]
  stockMovements   StockMovement[]
  cashMovements    CashMovement[]
  cashClosings     CashClosing[]
  sales            Sale[]

  @@unique([id, companyId])
  @@unique([companyId, name])
  @@map("site")
}

model SiteOpeningHours {
  id        String @id @default(uuid(7)) @db.Uuid
  siteId    String @map("site_id") @db.Uuid
  weekday   Int // 1 = lunes … 7 = domingo (ISO 8601)
  opensMin  Int    @map("opens_min") // minutos desde 00:00
  closesMin Int    @map("closes_min") // puede ser > 1440 si cierra al día siguiente

  site Site @relation(fields: [siteId], references: [id], onDelete: Cascade)

  @@index([siteId, weekday])
  @@map("site_opening_hours")
}

// El QR impreso contiene una URL con publicCode + firma HMAC.
// Rotar = revocar el actual y crear una versión nueva.
model SiteQrCode {
  id         String    @id @default(uuid(7)) @db.Uuid
  companyId  String    @map("company_id") @db.Uuid
  siteId     String    @map("site_id") @db.Uuid
  publicCode String    @unique @map("public_code")
  version    Int
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  revokedAt  DateTime? @map("revoked_at") @db.Timestamptz(3)

  company Company           @relation(fields: [companyId], references: [id], onDelete: Restrict)
  site    Site              @relation(fields: [siteId, companyId], references: [id, companyId], onDelete: Cascade)
  events  AttendanceEvent[]

  @@unique([siteId, version])
  @@map("site_qr_code")
}

// ─────────────────────────────── Empleados ───────────────────────────────

model Employee {
  id             String         @id @default(uuid(7)) @db.Uuid
  companyId      String         @map("company_id") @db.Uuid
  userId         String         @unique @map("user_id") @db.Uuid
  documentType   DocumentType   @map("document_type")
  documentNumber String         @map("document_number")
  firstName      String         @map("first_name")
  lastName       String         @map("last_name")
  phone          String?
  position       String
  defaultSiteId  String?        @map("default_site_id") @db.Uuid
  hireDate       DateTime       @map("hire_date") @db.Date
  status         EmployeeStatus @default(ACTIVE)
  // Código de acceso permanente (sin contraseña): SHA-256 para buscarlo y copia cifrada
  // (AES-256-GCM con NEXORA_SECRETS_KEY) para que el administrador lo vuelva a ver.
  accessCodeHash String?        @unique @map("access_code_hash")
  accessCodeEnc  String?        @map("access_code_enc")
  // El administrador decide si a este empleado se le exige Face ID o huella para marcar.
  requirePasskey Boolean        @default(false) @map("require_passkey")
  createdAt      DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime       @updatedAt @map("updated_at") @db.Timestamptz(3)

  company     Company            @relation(fields: [companyId], references: [id], onDelete: Restrict)
  user        User               @relation(fields: [userId], references: [id], onDelete: Restrict)
  defaultSite Site?              @relation(fields: [defaultSiteId], references: [id], onDelete: SetNull)
  contracts   EmployeeContract[]
  devices     DeviceBinding[]
  patterns    SchedulePattern[]
  shifts      ScheduledShift[]
  events      AttendanceEvent[]
  sessions    WorkSession[]
  overtime    OvertimeRequest[]
  novelties   Novelty[]
  estimates   PayrollEstimate[]

  @@unique([id, companyId])
  @@unique([companyId, documentType, documentNumber])
  @@index([companyId, status])
  @@map("employee")
}

// Condiciones contractuales versionadas: la pre-nómina usa la vigente en cada fecha.
model EmployeeContract {
  id            String       @id @default(uuid(7)) @db.Uuid
  companyId     String       @map("company_id") @db.Uuid
  employeeId    String       @map("employee_id") @db.Uuid
  contractType  ContractType @map("contract_type")
  salaryType    SalaryType   @default(ORDINARIO) @map("salary_type")
  monthlySalary Decimal      @map("monthly_salary") @db.Decimal(14, 2)
  weeklyHours   Decimal      @map("weekly_hours") @db.Decimal(5, 2)
  payFrequency  PayFrequency @map("pay_frequency")
  arlRiskClass  ArlRiskClass @default(I) @map("arl_risk_class")
  startDate     DateTime     @map("start_date") @db.Date
  endDate       DateTime?    @map("end_date") @db.Date
  createdAt     DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)

  company  Company  @relation(fields: [companyId], references: [id], onDelete: Restrict)
  employee Employee @relation(fields: [employeeId, companyId], references: [id, companyId], onDelete: Cascade)

  @@index([employeeId, startDate])
  @@map("employee_contract")
}

// Vinculación de dispositivo: un token aleatorio en cookie httpOnly de larga
// duración; en BD solo se guarda su hash. No se usa la IP como identificador.
model DeviceBinding {
  id           String       @id @default(uuid(7)) @db.Uuid
  companyId    String       @map("company_id") @db.Uuid
  employeeId   String       @map("employee_id") @db.Uuid
  tokenHash    String       @unique @map("token_hash")
  label        String
  userAgent    String?      @map("user_agent")
  status       DeviceStatus @default(PENDING)
  approvedById String?      @map("approved_by_id") @db.Uuid
  createdAt    DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  activatedAt  DateTime?    @map("activated_at") @db.Timestamptz(3)
  lastSeenAt   DateTime?    @map("last_seen_at") @db.Timestamptz(3)
  revokedAt    DateTime?    @map("revoked_at") @db.Timestamptz(3)
  revokeReason String?      @map("revoke_reason")

  company  Company             @relation(fields: [companyId], references: [id], onDelete: Restrict)
  employee Employee            @relation(fields: [employeeId, companyId], references: [id, companyId], onDelete: Cascade)
  sessions Session[]
  passkeys PasskeyCredential[]
  events   AttendanceEvent[]

  @@index([employeeId, status])
  @@map("device_binding")
}

// ──────────────────────────────── Horarios ───────────────────────────────

model ShiftTemplate {
  id           String  @id @default(uuid(7)) @db.Uuid
  companyId    String  @map("company_id") @db.Uuid
  name         String
  startMin     Int     @map("start_min") // minutos desde 00:00
  endMin       Int     @map("end_min") // > 1440 si termina al día siguiente
  breakMinutes Int     @default(0) @map("break_minutes")
  breakPaid    Boolean @default(false) @map("break_paid")
  color        String  @default("blue")
  active       Boolean @default(true)

  company     Company              @relation(fields: [companyId], references: [id], onDelete: Restrict)
  patternDays SchedulePatternDay[]
  shifts      ScheduledShift[]

  @@unique([companyId, name])
  @@map("shift_template")
}

// Patrón cíclico (semanal o rotativo) que genera turnos programados.
model SchedulePattern {
  id            String    @id @default(uuid(7)) @db.Uuid
  companyId     String    @map("company_id") @db.Uuid
  employeeId    String    @map("employee_id") @db.Uuid
  name          String
  cycleDays     Int       @default(7) @map("cycle_days")
  anchorDate    DateTime  @map("anchor_date") @db.Date // día 0 del ciclo
  effectiveFrom DateTime  @map("effective_from") @db.Date
  effectiveTo   DateTime? @map("effective_to") @db.Date

  company  Company              @relation(fields: [companyId], references: [id], onDelete: Restrict)
  employee Employee             @relation(fields: [employeeId, companyId], references: [id, companyId], onDelete: Cascade)
  days     SchedulePatternDay[]

  @@index([employeeId, effectiveFrom])
  @@map("schedule_pattern")
}

// Un día del ciclo puede tener varias filas (turno partido) o ninguna (descanso).
model SchedulePatternDay {
  id         String @id @default(uuid(7)) @db.Uuid
  patternId  String @map("pattern_id") @db.Uuid
  dayIndex   Int    @map("day_index")
  templateId String @map("template_id") @db.Uuid
  siteId     String @map("site_id") @db.Uuid

  pattern  SchedulePattern @relation(fields: [patternId], references: [id], onDelete: Cascade)
  template ShiftTemplate   @relation(fields: [templateId], references: [id], onDelete: Restrict)
  site     Site            @relation(fields: [siteId], references: [id], onDelete: Restrict)

  @@index([patternId, dayIndex])
  @@map("schedule_pattern_day")
}

// Turno concreto de un empleado en una fecha (materializado desde un patrón o manual).
model ScheduledShift {
  id           String      @id @default(uuid(7)) @db.Uuid
  companyId    String      @map("company_id") @db.Uuid
  employeeId   String      @map("employee_id") @db.Uuid
  siteId       String      @map("site_id") @db.Uuid
  templateId   String?     @map("template_id") @db.Uuid
  workDate     DateTime    @map("work_date") @db.Date
  startAt      DateTime    @map("start_at") @db.Timestamptz(3)
  endAt        DateTime    @map("end_at") @db.Timestamptz(3)
  breakMinutes Int         @default(0) @map("break_minutes")
  breakPaid    Boolean     @default(false) @map("break_paid")
  status       ShiftStatus @default(PLANNED)
  note         String?

  company  Company        @relation(fields: [companyId], references: [id], onDelete: Restrict)
  employee Employee       @relation(fields: [employeeId, companyId], references: [id, companyId], onDelete: Cascade)
  site     Site           @relation(fields: [siteId, companyId], references: [id, companyId], onDelete: Restrict)
  template ShiftTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)
  sessions WorkSession[]

  @@index([companyId, workDate])
  @@index([employeeId, startAt])
  @@map("scheduled_shift")
}

model Holiday {
  id        String   @id @default(uuid(7)) @db.Uuid
  companyId String?  @map("company_id") @db.Uuid // null = festivo nacional
  date      DateTime @db.Date
  name      String
  source    String // p. ej. "Ley 51 de 1983 (Ley Emiliani)"

  company Company? @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId, date])
  @@index([date])
  @@map("holiday")
}

// ─────────────────────────────── Asistencia ──────────────────────────────

// Marcación inmutable (solo inserción). Hora tomada del servidor.
model AttendanceEvent {
  id              String             @id @default(uuid(7)) @db.Uuid
  companyId       String             @map("company_id") @db.Uuid
  employeeId      String             @map("employee_id") @db.Uuid
  siteId          String             @map("site_id") @db.Uuid
  type            PunchType
  occurredAt      DateTime           @default(now()) @map("occurred_at") @db.Timestamptz(3)
  source          PunchSource
  status          PunchStatus        @default(ACCEPTED)
  verification    VerificationMethod
  geoStatus       GeoStatus          @map("geo_status")
  latitude        Decimal?           @db.Decimal(9, 6)
  longitude       Decimal?           @db.Decimal(9, 6)
  accuracyMeters  Int?               @map("accuracy_meters")
  distanceMeters  Int?               @map("distance_meters")
  qrCodeId        String?            @map("qr_code_id") @db.Uuid
  deviceBindingId String?            @map("device_binding_id") @db.Uuid
  createdById     String?            @map("created_by_id") @db.Uuid // solo marcaciones manuales
  reason          String? // obligatorio si es manual o corrige otra
  correctsEventId String?            @map("corrects_event_id") @db.Uuid
  idempotencyKey  String             @unique @map("idempotency_key")
  userAgent       String?            @map("user_agent")

  company       Company           @relation(fields: [companyId], references: [id], onDelete: Restrict)
  employee      Employee          @relation(fields: [employeeId, companyId], references: [id, companyId], onDelete: Restrict)
  site          Site              @relation(fields: [siteId, companyId], references: [id, companyId], onDelete: Restrict)
  qrCode        SiteQrCode?       @relation(fields: [qrCodeId], references: [id], onDelete: Restrict)
  deviceBinding DeviceBinding?    @relation(fields: [deviceBindingId], references: [id], onDelete: Restrict)
  createdBy     User?             @relation("PunchCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  corrects      AttendanceEvent?  @relation("Correction", fields: [correctsEventId], references: [id], onDelete: Restrict)
  correctedBy   AttendanceEvent[] @relation("Correction")
  opensSession  WorkSession?      @relation("SessionIn")
  closesSession WorkSession?      @relation("SessionOut")

  @@index([companyId, occurredAt])
  @@index([employeeId, occurredAt])
  @@map("attendance_event")
}

// Intentos rechazados: evidencia para auditoría y detección de abuso.
model AttendanceAttempt {
  id         String        @id @default(uuid(7)) @db.Uuid
  companyId  String?       @map("company_id") @db.Uuid
  userId     String?       @map("user_id") @db.Uuid
  siteId     String?       @map("site_id") @db.Uuid
  reason     AttemptReason
  detail     Json?
  occurredAt DateTime      @default(now()) @map("occurred_at") @db.Timestamptz(3)
  userAgent  String?       @map("user_agent")

  company Company? @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId, occurredAt])
  @@index([userId, occurredAt])
  @@map("attendance_attempt")
}

// Jornada: par entrada/salida. El tiempo registrado sale de aquí y no se
// modifica por decisiones de aprobación.
model WorkSession {
  id               String            @id @default(uuid(7)) @db.Uuid
  companyId        String            @map("company_id") @db.Uuid
  employeeId       String            @map("employee_id") @db.Uuid
  siteId           String            @map("site_id") @db.Uuid
  scheduledShiftId String?           @map("scheduled_shift_id") @db.Uuid
  inEventId        String            @unique @map("in_event_id") @db.Uuid
  outEventId       String?           @unique @map("out_event_id") @db.Uuid
  startAt          DateTime          @map("start_at") @db.Timestamptz(3)
  endAt            DateTime?         @map("end_at") @db.Timestamptz(3)
  breakMinutes     Int               @default(0) @map("break_minutes")
  status           WorkSessionStatus @default(OPEN)
  reviewNote       String?           @map("review_note")

  company  Company           @relation(fields: [companyId], references: [id], onDelete: Restrict)
  employee Employee          @relation(fields: [employeeId, companyId], references: [id, companyId], onDelete: Restrict)
  site     Site              @relation(fields: [siteId, companyId], references: [id, companyId], onDelete: Restrict)
  shift    ScheduledShift?   @relation(fields: [scheduledShiftId], references: [id], onDelete: SetNull)
  inEvent  AttendanceEvent   @relation("SessionIn", fields: [inEventId], references: [id], onDelete: Restrict)
  outEvent AttendanceEvent?  @relation("SessionOut", fields: [outEventId], references: [id], onDelete: Restrict)
  overtime OvertimeRequest[]

  @@index([companyId, startAt])
  @@index([employeeId, startAt])
  @@map("work_session")
}

// ───────────────────────── Horas extra y novedades ───────────────────────

// La decisión del administrador vive aquí; los minutos detectados quedan
// intactos aunque se rechace la solicitud.
model OvertimeRequest {
  id              String        @id @default(uuid(7)) @db.Uuid
  companyId       String        @map("company_id") @db.Uuid
  employeeId      String        @map("employee_id") @db.Uuid
  workSessionId   String?       @map("work_session_id") @db.Uuid
  workDate        DateTime      @map("work_date") @db.Date
  detectedMinutes Int           @map("detected_minutes")
  approvedMinutes Int?          @map("approved_minutes")
  employeeNote    String?       @map("employee_note")
  status          RequestStatus @default(PENDING)
  decidedById     String?       @map("decided_by_id") @db.Uuid
  decidedAt       DateTime?     @map("decided_at") @db.Timestamptz(3)
  decisionNote    String?       @map("decision_note")
  createdAt       DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)

  company     Company      @relation(fields: [companyId], references: [id], onDelete: Restrict)
  employee    Employee     @relation(fields: [employeeId, companyId], references: [id, companyId], onDelete: Restrict)
  workSession WorkSession? @relation(fields: [workSessionId], references: [id], onDelete: Restrict)
  decidedBy   User?        @relation("OvertimeDecider", fields: [decidedById], references: [id], onDelete: Restrict)

  @@unique([workSessionId])
  @@index([companyId, status])
  @@map("overtime_request")
}

model Novelty {
  id           String        @id @default(uuid(7)) @db.Uuid
  companyId    String        @map("company_id") @db.Uuid
  employeeId   String        @map("employee_id") @db.Uuid
  type         NoveltyType
  startDate    DateTime      @map("start_date") @db.Date
  endDate      DateTime      @map("end_date") @db.Date
  hours        Decimal?      @db.Decimal(6, 2) // permisos por horas
  note         String?
  status       RequestStatus @default(PENDING)
  requestedBy  String        @map("requested_by") @db.Uuid
  decidedById  String?       @map("decided_by_id") @db.Uuid
  decidedAt    DateTime?     @map("decided_at") @db.Timestamptz(3)
  decisionNote String?       @map("decision_note")
  createdAt    DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)

  company   Company  @relation(fields: [companyId], references: [id], onDelete: Restrict)
  employee  Employee @relation(fields: [employeeId, companyId], references: [id, companyId], onDelete: Restrict)
  decidedBy User?    @relation("NoveltyDecider", fields: [decidedById], references: [id], onDelete: Restrict)
  requester User     @relation("NoveltyRequester", fields: [requestedBy], references: [id], onDelete: Restrict)

  @@index([companyId, startDate])
  @@index([employeeId, startDate])
  @@map("novelty")
}

// ─────────────────────────────── Pre-nómina ──────────────────────────────

// Parámetro legal versionado. companyId null = valor nacional.
// Ningún valor se inventa: cada fila cita norma y URL de verificación.
model LaborParameter {
  id          String        @id @default(uuid(7)) @db.Uuid
  companyId   String?       @map("company_id") @db.Uuid
  key         String // p. ej. SMMLV, AUX_TRANSPORTE, RECARGO_NOCTURNO
  value       Decimal       @db.Decimal(16, 4)
  unit        ParameterUnit
  validFrom   DateTime      @map("valid_from") @db.Date
  validTo     DateTime?     @map("valid_to") @db.Date
  legalSource String        @map("legal_source")
  sourceUrl   String?       @map("source_url")
  verifiedAt  DateTime?     @map("verified_at") @db.Date
  notes       String?
  createdAt   DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)

  company Company? @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId, key, validFrom])
  @@index([key, validFrom])
  @@map("labor_parameter")
}

model PayrollPeriod {
  id        String        @id @default(uuid(7)) @db.Uuid
  companyId String        @map("company_id") @db.Uuid
  startDate DateTime      @map("start_date") @db.Date
  endDate   DateTime      @map("end_date") @db.Date
  frequency PayFrequency
  status    PayrollStatus @default(DRAFT)
  createdAt DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)

  company   Company           @relation(fields: [companyId], references: [id], onDelete: Restrict)
  estimates PayrollEstimate[]

  @@unique([id, companyId])
  @@unique([companyId, startDate, endDate])
  @@map("payroll_period")
}

// Estimación (no liquidación legal). Guarda copia de los parámetros usados
// y las advertencias, para que el cálculo sea reproducible y auditable.
model PayrollEstimate {
  id                String   @id @default(uuid(7)) @db.Uuid
  companyId         String   @map("company_id") @db.Uuid
  periodId          String   @map("period_id") @db.Uuid
  employeeId        String   @map("employee_id") @db.Uuid
  grossEstimate     Decimal  @map("gross_estimate") @db.Decimal(14, 2)
  deductions        Decimal  @db.Decimal(14, 2)
  netEstimate       Decimal  @map("net_estimate") @db.Decimal(14, 2)
  employerCost      Decimal  @map("employer_cost") @db.Decimal(14, 2)
  parameterSnapshot Json     @map("parameter_snapshot")
  warnings          Json     @default("[]")
  computedAt        DateTime @default(now()) @map("computed_at") @db.Timestamptz(3)

  company  Company               @relation(fields: [companyId], references: [id], onDelete: Restrict)
  period   PayrollPeriod         @relation(fields: [periodId, companyId], references: [id, companyId], onDelete: Cascade)
  employee Employee              @relation(fields: [employeeId, companyId], references: [id, companyId], onDelete: Restrict)
  lines    PayrollEstimateLine[]

  @@unique([periodId, employeeId])
  @@map("payroll_estimate")
}

model PayrollEstimateLine {
  id         String  @id @default(uuid(7)) @db.Uuid
  estimateId String  @map("estimate_id") @db.Uuid
  concept    String // p. ej. SALARIO_BASICO, HED, RN, AUX_TRANSPORTE, SALUD_EMPLEADO
  kind       String // DEVENGADO | DEDUCCION | APORTE_EMPLEADOR | PROVISION
  quantity   Decimal @db.Decimal(10, 2)
  rate       Decimal @db.Decimal(16, 4)
  amount     Decimal @db.Decimal(14, 2)
  basis      String // explicación legible del cálculo

  estimate PayrollEstimate @relation(fields: [estimateId], references: [id], onDelete: Cascade)

  @@index([estimateId])
  @@map("payroll_estimate_line")
}

// Invitación para que el dueño de un negocio registre su empresa él mismo.
// Solo se guarda el hash del token; el link se muestra una vez a quien la crea.
// Un solo uso y con vencimiento.
model CompanyInvitation {
  id           String    @id @default(uuid(7)) @db.Uuid
  tokenHash    String    @unique @map("token_hash")
  label        String // a quién se envió, p. ej. "Panadería de Rosa"
  planCode     String?   @map("plan_code")
  maxEmployees Int?      @map("max_employees")
  maxSites     Int?      @map("max_sites")
  expiresAt    DateTime  @map("expires_at") @db.Timestamptz(3)
  usedAt       DateTime? @map("used_at") @db.Timestamptz(3)
  revokedAt    DateTime? @map("revoked_at") @db.Timestamptz(3)
  companyId    String?   @unique @map("company_id") @db.Uuid
  createdById  String?   @map("created_by_id") @db.Uuid
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  company Company? @relation(fields: [companyId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@map("company_invitation")
}

enum LeadStatus {
  NEW
  CONTACTED
  INVITED
  DISCARDED
}

// Solicitud de un negocio interesado, enviada desde la página pública.
// Solo se guarda el hash de la IP (para frenar envíos repetidos).
model Lead {
  id           String     @id @default(uuid(7)) @db.Uuid
  businessName String     @map("business_name")
  contactName  String     @map("contact_name")
  email        String
  phone        String
  city         String?
  employees    String // rango: 1-5, 6-15, 16-30, 31+
  sites        Int?
  message      String?
  status       LeadStatus @default(NEW)
  ipHash       String?    @map("ip_hash")
  createdAt    DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([createdAt])
  @@index([ipHash, createdAt])
  @@map("lead")
}

// Intentos de ingreso fallidos por red (IP). Solo se guarda el hash de la IP,
// nunca la IP. Complementa el bloqueo por cuenta: frena a quien prueba muchas
// cuentas distintas desde la misma red.
model LoginThrottle {
  id         String   @id @default(uuid(7)) @db.Uuid
  ipHash     String   @map("ip_hash")
  occurredAt DateTime @default(now()) @map("occurred_at") @db.Timestamptz(3)

  @@index([ipHash, occurredAt])
  @@map("login_throttle")
}

// ──────────────────────────────── Auditoría ──────────────────────────────

// Solo inserción (trigger en la migración).
model AuditLog {
  id          String   @id @default(uuid(7)) @db.Uuid
  companyId   String?  @map("company_id") @db.Uuid
  actorUserId String?  @map("actor_user_id") @db.Uuid
  action      String // p. ej. employee.create, overtime.approve, device.revoke
  entityType  String   @map("entity_type")
  entityId    String?  @map("entity_id")
  before      Json?
  after       Json?
  occurredAt  DateTime @default(now()) @map("occurred_at") @db.Timestamptz(3)
  userAgent   String?  @map("user_agent")

  company Company? @relation(fields: [companyId], references: [id], onDelete: Restrict)
  actor   User?    @relation("AuditActor", fields: [actorUserId], references: [id], onDelete: Restrict)

  @@index([companyId, occurredAt])
  @@index([entityType, entityId])
  @@map("audit_log")
}

// ─────────────────────────────── Integraciones ───────────────────────────────

enum IntegrationStatus {
  UNTESTED
  CONNECTED
  ERROR
}

// Conexión con un servicio externo (Meta, TikTok, WhatsApp, facturación
// electrónica, correo, Claude). companyId null = de la plataforma (p. ej. la
// llave de Claude del asistente de la página de inicio). Los datos sensibles
// (tokens, llaves) van cifrados en secretCipher (AES-256-GCM con
// NEXORA_SECRETS_KEY); nunca se devuelven al navegador.
model Integration {
  id           String            @id @default(uuid(7)) @db.Uuid
  companyId    String?           @map("company_id") @db.Uuid
  provider     String
  config       Json              @default("{}")
  secretCipher String?           @map("secret_cipher")
  secretKeys   String[]          @default([]) @map("secret_keys")
  status       IntegrationStatus @default(UNTESTED)
  lastError    String?           @map("last_error")
  testedAt     DateTime?         @map("tested_at") @db.Timestamptz(3)
  webhookToken String            @unique @map("webhook_token")
  updatedById  String?           @map("updated_by_id") @db.Uuid
  createdAt    DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime          @updatedAt @map("updated_at") @db.Timestamptz(3)

  company Company? @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId, provider])
  @@map("integration")
}

// ─────────────────────────────── Inventario ───────────────────────────────

enum ProductKind {
  PRODUCT
  SERVICE
}

enum StockMovementType {
  IN // entrada (compra, producción)
  OUT // salida (consumo, daño, pérdida)
  ADJUST // ajuste por conteo físico
  TRANSFER_OUT // traslado: sale de una sede
  TRANSFER_IN // traslado: entra a otra sede
  SALE // venta (facturación)
}

// Producto o servicio que vende la empresa. Los servicios no llevan stock.
model Product {
  id        String      @id @default(uuid(7)) @db.Uuid
  companyId String      @map("company_id") @db.Uuid
  sku       String
  name      String
  category  String?
  kind      ProductKind @default(PRODUCT)
  unit      String      @default("UNIDAD")
  price     Decimal     @db.Decimal(14, 2)
  cost      Decimal?    @db.Decimal(14, 2)
  taxRate   Decimal     @default(0) @map("tax_rate") @db.Decimal(5, 2)
  minStock  Decimal     @default(0) @map("min_stock") @db.Decimal(14, 3)
  barcode   String?
  active    Boolean     @default(true)
  /// Punto de venta: subcategoría del catálogo visual, producto base (p. ej. «Hilo algodón
  /// crochet») y su variante (gramaje o tamaño y color). Cada variante es un producto con su stock.
  posCategoryId String?  @map("pos_category_id") @db.Uuid
  posGroup      String?  @map("pos_group")
  variantSize   String?  @map("variant_size")
  variantColor  String?  @map("variant_color")
  variantHex    String?  @map("variant_hex")
  imageUrl      String?  @map("image_url")
  createdAt DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime    @updatedAt @map("updated_at") @db.Timestamptz(3)

  company     Company         @relation(fields: [companyId], references: [id], onDelete: Restrict)
  posCategory PosCategory?    @relation(fields: [posCategoryId, companyId], references: [id, companyId], onDelete: Restrict)
  movements   StockMovement[]
  saleItems   SaleItem[]

  @@unique([id, companyId])
  @@unique([companyId, sku])
  @@index([companyId, active])
  @@index([companyId, posCategoryId])
  @@map("product")
}

// Movimiento de inventario (solo inserción): el stock de cada sede es la suma
// de sus movimientos. Una corrección es un movimiento nuevo, nunca una edición.
model StockMovement {
  id          String            @id @default(uuid(7)) @db.Uuid
  companyId   String            @map("company_id") @db.Uuid
  productId   String            @map("product_id") @db.Uuid
  siteId      String            @map("site_id") @db.Uuid
  type        StockMovementType
  /// Cambio de cantidad: positivo entra, negativo sale.
  quantity    Decimal           @db.Decimal(14, 3)
  unitCost    Decimal?          @map("unit_cost") @db.Decimal(14, 2)
  reason      String
  reference   String?
  transferId  String?           @map("transfer_id") @db.Uuid
  createdById String?           @map("created_by_id") @db.Uuid
  createdAt   DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)

  company   Company @relation(fields: [companyId], references: [id], onDelete: Restrict)
  product   Product @relation(fields: [productId, companyId], references: [id, companyId], onDelete: Restrict)
  site      Site    @relation(fields: [siteId, companyId], references: [id, companyId], onDelete: Restrict)
  createdBy User?   @relation("StockMovementBy", fields: [createdById], references: [id], onDelete: Restrict)

  @@index([companyId, productId, siteId])
  @@index([companyId, createdAt])
  @@map("stock_movement")
}

// ─────────────────────────────── Caja ───────────────────────────────

enum CashMovementType {
  IN
  OUT
}

enum PaymentMethod {
  CASH
  TRANSFER
  CARD
  OTHER
}

// Ingreso o egreso de la caja de una sede en un día. Nunca se borra: se anula
// con motivo (la base solo permite llenar los datos de anulación, una vez).
model CashMovement {
  id          String           @id @default(uuid(7)) @db.Uuid
  companyId   String           @map("company_id") @db.Uuid
  siteId      String           @map("site_id") @db.Uuid
  date        DateTime         @db.Date
  type        CashMovementType
  category    String
  method      PaymentMethod
  amount      Decimal          @db.Decimal(14, 2)
  description String?
  /// Origen automático (p. ej. una venta): una sola vez por origen.
  source      String?
  sourceId    String?          @map("source_id") @db.Uuid
  createdById String           @map("created_by_id") @db.Uuid
  createdAt   DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  voidedAt    DateTime?        @map("voided_at") @db.Timestamptz(3)
  voidedById  String?          @map("voided_by_id") @db.Uuid
  voidReason  String?          @map("void_reason")

  company   Company @relation(fields: [companyId], references: [id], onDelete: Restrict)
  site      Site    @relation(fields: [siteId, companyId], references: [id, companyId], onDelete: Restrict)
  createdBy User    @relation("CashMovementBy", fields: [createdById], references: [id], onDelete: Restrict)
  voidedBy  User?   @relation("CashMovementVoidedBy", fields: [voidedById], references: [id], onDelete: Restrict)

  @@index([companyId, siteId, date])
  @@map("cash_movement")
}

// Cierre del día de una sede: efectivo esperado vs. contado. Con un cierre
// vigente el día queda bloqueado; reabrirlo exige motivo y queda registrado.
model CashClosing {
  id             String    @id @default(uuid(7)) @db.Uuid
  companyId      String    @map("company_id") @db.Uuid
  siteId         String    @map("site_id") @db.Uuid
  date           DateTime  @db.Date
  openingBalance Decimal   @map("opening_balance") @db.Decimal(14, 2)
  cashIn         Decimal   @map("cash_in") @db.Decimal(14, 2)
  cashOut        Decimal   @map("cash_out") @db.Decimal(14, 2)
  expected       Decimal   @db.Decimal(14, 2)
  counted        Decimal   @db.Decimal(14, 2)
  difference     Decimal   @db.Decimal(14, 2)
  /// Totales del día por tipo y medio de pago.
  totals         Json
  notes          String?
  closedById     String    @map("closed_by_id") @db.Uuid
  closedAt       DateTime  @default(now()) @map("closed_at") @db.Timestamptz(3)
  reopenedAt     DateTime? @map("reopened_at") @db.Timestamptz(3)
  reopenedById   String?   @map("reopened_by_id") @db.Uuid
  reopenReason   String?   @map("reopen_reason")

  company    Company @relation(fields: [companyId], references: [id], onDelete: Restrict)
  site       Site    @relation(fields: [siteId, companyId], references: [id, companyId], onDelete: Restrict)
  closedBy   User    @relation("CashClosingBy", fields: [closedById], references: [id], onDelete: Restrict)
  reopenedBy User?   @relation("CashClosingReopenedBy", fields: [reopenedById], references: [id], onDelete: Restrict)

  @@index([companyId, siteId, date])
  @@map("cash_closing")
}

// ─────────────────────────────── Ventas ───────────────────────────────

enum CustomerDocType {
  NIT
  CC
  CE
  PASAPORTE
  PPT
  OTRO
}

// Cliente de la empresa (comprador). Lo usan las ventas y, después, el CRM.
model Customer {
  id             String           @id @default(uuid(7)) @db.Uuid
  companyId      String           @map("company_id") @db.Uuid
  name           String
  documentType   CustomerDocType? @map("document_type")
  documentNumber String?          @map("document_number")
  email          String?
  phone          String?
  address        String?
  city           String?
  /// De dónde llegó: MANUAL, SALE, META, WHATSAPP, TIKTOK, WEB.
  source         String           @default("MANUAL")
  notes          String?
  /// Autorización para contacto comercial (Ley 1581 de 2012) y cuándo/cómo se obtuvo.
  marketingConsent Boolean        @default(false) @map("marketing_consent")
  consentAt      DateTime?        @map("consent_at") @db.Timestamptz(3)
  consentSource  String?          @map("consent_source")
  createdAt      DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)

  company       Company        @relation(fields: [companyId], references: [id], onDelete: Restrict)
  sales         Sale[]
  appointments  Appointment[]
  deals         Deal[]
  activities    CrmActivity[]
  conversations Conversation[]

  @@unique([id, companyId])
  @@unique([companyId, documentType, documentNumber])
  @@index([companyId, name])
  @@index([companyId, phone])
  @@index([companyId, email])
  @@map("customer")
}

enum SaleStatus {
  COMPLETED
  VOIDED
}

// Venta con número consecutivo por empresa. Descuenta inventario y entra a
// la caja de la sede. Guarda copia de los datos del cliente y de cada
// producto (si luego cambian, la venta no cambia). No se borra: se anula.
model Sale {
  id             String        @id @default(uuid(7)) @db.Uuid
  companyId      String        @map("company_id") @db.Uuid
  siteId         String        @map("site_id") @db.Uuid
  number         Int
  date           DateTime      @db.Date
  status         SaleStatus    @default(COMPLETED)
  customerId     String?       @map("customer_id") @db.Uuid
  customerName   String        @map("customer_name")
  customerDoc    String?       @map("customer_doc")
  subtotal       Decimal       @db.Decimal(14, 2)
  discountTotal  Decimal       @default(0) @map("discount_total") @db.Decimal(14, 2)
  taxTotal       Decimal       @map("tax_total") @db.Decimal(14, 2)
  total          Decimal       @db.Decimal(14, 2)
  paymentMethod  PaymentMethod @map("payment_method")
  notes          String?
  createdById    String        @map("created_by_id") @db.Uuid
  createdAt      DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  voidedAt       DateTime?     @map("voided_at") @db.Timestamptz(3)
  voidedById     String?       @map("voided_by_id") @db.Uuid
  voidReason     String?       @map("void_reason")

  company   Company    @relation(fields: [companyId], references: [id], onDelete: Restrict)
  site      Site       @relation(fields: [siteId, companyId], references: [id, companyId], onDelete: Restrict)
  customer  Customer?  @relation(fields: [customerId, companyId], references: [id, companyId], onDelete: Restrict)
  createdBy User       @relation("SaleBy", fields: [createdById], references: [id], onDelete: Restrict)
  voidedBy  User?      @relation("SaleVoidedBy", fields: [voidedById], references: [id], onDelete: Restrict)
  items     SaleItem[]

  @@unique([companyId, number])
  @@index([companyId, date])
  @@map("sale")
}

model SaleItem {
  id          String  @id @default(uuid(7)) @db.Uuid
  saleId      String  @map("sale_id") @db.Uuid
  productId   String  @map("product_id") @db.Uuid
  companyId   String  @map("company_id") @db.Uuid
  sku         String
  name        String
  quantity    Decimal @db.Decimal(14, 3)
  unitPrice   Decimal @map("unit_price") @db.Decimal(14, 2)
  discount    Decimal @default(0) @db.Decimal(14, 2)
  taxRate     Decimal @map("tax_rate") @db.Decimal(5, 2)
  subtotal    Decimal @db.Decimal(14, 2)
  tax         Decimal @db.Decimal(14, 2)
  total       Decimal @db.Decimal(14, 2)

  sale    Sale    @relation(fields: [saleId], references: [id], onDelete: Restrict)
  product Product @relation(fields: [productId, companyId], references: [id, companyId], onDelete: Restrict)

  @@index([saleId])
  @@map("sale_item")
}

// ─────────────────────────────── CRM ───────────────────────────────

enum DealStage {
  NEW // nuevo
  CONTACTED // contactado
  PROPOSAL // propuesta
  NEGOTIATION // negociación
  WON // ganado
  LOST // perdido
}

// Oportunidad de negocio con un cliente, en una etapa del embudo.
model Deal {
  id            String    @id @default(uuid(7)) @db.Uuid
  companyId     String    @map("company_id") @db.Uuid
  customerId    String    @map("customer_id") @db.Uuid
  title         String
  value         Decimal?  @db.Decimal(14, 2)
  stage         DealStage @default(NEW)
  source        String    @default("MANUAL")
  ownerId       String?   @map("owner_id") @db.Uuid
  expectedClose DateTime? @map("expected_close") @db.Date
  lostReason    String?   @map("lost_reason")
  closedAt      DateTime? @map("closed_at") @db.Timestamptz(3)
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  company    Company       @relation(fields: [companyId], references: [id], onDelete: Restrict)
  customer   Customer      @relation(fields: [customerId, companyId], references: [id, companyId], onDelete: Restrict)
  owner      User?         @relation("DealOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  activities CrmActivity[]

  @@unique([id, companyId])
  @@index([companyId, stage])
  @@index([companyId, customerId])
  @@map("deal")
}

enum CrmActivityType {
  NOTE
  CALL
  WHATSAPP
  EMAIL
  MEETING
  TASK
  STAGE // cambio de etapa (automático)
  LEAD // llegada de un lead (automático)
}

// Seguimiento: nota, llamada, mensaje, reunión o tarea (con fecha) de un cliente.
model CrmActivity {
  id          String          @id @default(uuid(7)) @db.Uuid
  companyId   String          @map("company_id") @db.Uuid
  customerId  String          @map("customer_id") @db.Uuid
  dealId      String?         @map("deal_id") @db.Uuid
  type        CrmActivityType
  body        String
  dueAt       DateTime?       @map("due_at") @db.Timestamptz(3)
  doneAt      DateTime?       @map("done_at") @db.Timestamptz(3)
  /// Identificador externo (p. ej. id del lead de Meta o del mensaje de WhatsApp) para no duplicar.
  externalId  String?         @map("external_id")
  createdById String?         @map("created_by_id") @db.Uuid
  createdAt   DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)

  company   Company  @relation(fields: [companyId], references: [id], onDelete: Restrict)
  customer  Customer @relation(fields: [customerId, companyId], references: [id, companyId], onDelete: Restrict)
  deal      Deal?    @relation(fields: [dealId, companyId], references: [id, companyId], onDelete: Restrict)
  createdBy User?    @relation("CrmActivityBy", fields: [createdById], references: [id], onDelete: Restrict)

  @@unique([companyId, externalId])
  @@index([companyId, customerId, createdAt])
  @@index([companyId, dueAt])
  @@map("crm_activity")
}

// ─────────────────────────────── Mensajes ───────────────────────────────

enum MessageChannel {
  WHATSAPP
  MESSENGER
  INSTAGRAM
}

enum MessageDirection {
  IN
  OUT
}

enum MessageStatus {
  RECEIVED
  SENT
  DELIVERED
  READ
  FAILED
}

// Conversación con un cliente por un canal (un número de WhatsApp, una
// persona en Messenger o en Instagram).
model Conversation {
  id            String         @id @default(uuid(7)) @db.Uuid
  companyId     String         @map("company_id") @db.Uuid
  customerId    String         @map("customer_id") @db.Uuid
  channel       MessageChannel
  /// Quién es del otro lado: el número (WhatsApp) o el id de la persona en Messenger/Instagram.
  externalUser  String         @map("external_user")
  lastMessageAt DateTime       @map("last_message_at") @db.Timestamptz(3)
  /// Último mensaje del cliente: abre la ventana de 24 h para responder libremente.
  lastInboundAt DateTime?      @map("last_inbound_at") @db.Timestamptz(3)
  lastPreview   String?        @map("last_preview")
  unread        Int            @default(0)
  /// Análisis de la IA del último mensaje: etiqueta, resumen y respuesta sugerida.
  aiTag         String?        @map("ai_tag")
  aiSummary     String?        @map("ai_summary")
  aiSuggestion  String?        @map("ai_suggestion")
  needsHuman    Boolean        @default(false) @map("needs_human")
  humanReason   String?        @map("human_reason")
  aiAt          DateTime?      @map("ai_at") @db.Timestamptz(3)
  aiError       String?        @map("ai_error")
  /// La IA no responde sola en este chat (una persona lo tomó).
  aiPaused      Boolean        @default(false) @map("ai_paused")
  /// Anuncio de Meta por el que llegó el chat (botón «Enviar mensaje» de un anuncio o publicación).
  adId          String?        @map("ad_id")
  adTitle       String?        @map("ad_title")
  adUrl         String?        @map("ad_url")
  /// "ad" (anuncio pagado) o "post" (publicación orgánica).
  adSourceType  String?        @map("ad_source_type")
  adAt          DateTime?      @map("ad_at") @db.Timestamptz(3)
  /// Chat de demostración (cargado para mostrar la bandeja sin conectar nada): no se envía a ninguna plataforma.
  demo          Boolean        @default(false)
  createdAt     DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)

  company  Company   @relation(fields: [companyId], references: [id], onDelete: Restrict)
  customer Customer  @relation(fields: [customerId, companyId], references: [id, companyId], onDelete: Restrict)
  messages Message[]

  @@unique([id, companyId])
  @@unique([companyId, channel, externalUser])
  @@index([companyId, lastMessageAt])
  @@index([companyId, adId])
  @@map("conversation")
}

model Message {
  id             String           @id @default(uuid(7)) @db.Uuid
  companyId      String           @map("company_id") @db.Uuid
  conversationId String           @map("conversation_id") @db.Uuid
  direction      MessageDirection
  body           String
  /// Tipo en la plataforma (text, image, audio…); lo no textual se muestra como aviso.
  kind           String           @default("text")
  status         MessageStatus
  /// Quién lo escribió: CUSTOMER (cliente), NEXORA (persona desde Nexora), AI (la IA), PHONE (desde la app del celular).
  origin         String           @default("CUSTOMER")
  error          String?
  /// Id del mensaje en la plataforma (para no duplicar y para actualizar su estado).
  externalId     String?          @map("external_id")
  /// Botones que se enviaron con el mensaje ([{id, title}]) o el botón que tocó el cliente ({id}).
  buttons        Json?
  sentById       String?          @map("sent_by_id") @db.Uuid
  createdAt      DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)

  company      Company      @relation(fields: [companyId], references: [id], onDelete: Restrict)
  conversation Conversation @relation(fields: [conversationId, companyId], references: [id, companyId], onDelete: Restrict)
  sentBy       User?        @relation("MessageSentBy", fields: [sentById], references: [id], onDelete: Restrict)

  @@unique([companyId, externalId])
  @@index([conversationId, createdAt])
  @@map("message")
}

enum AiMode {
  SUGGEST // la IA sugiere y una persona envía
  AUTO // la IA responde sola (salvo que el chat deba atenderlo una persona)
}

// Configuración de la IA de mensajes de una empresa (lo que sabe y cómo responde).
model CrmAiConfig {
  companyId    String   @id @map("company_id") @db.Uuid
  enabled      Boolean  @default(false)
  mode         AiMode   @default(SUGGEST)
  /// Datos del negocio: horarios, precios, políticas, preguntas frecuentes…
  knowledge    String   @default("")
  /// Cómo debe sonar y qué debe buscar (p. ej. cerrar ventas, agendar).
  instructions String   @default("")
  /// Cuándo pasar el chat a una persona además de las reglas fijas.
  escalation   String   @default("")
  /// Aprendizaje diario: cada mañana la IA revisa los chats de los últimos 7 días y ajusta sus conocimientos.
  autoLearn     Boolean   @default(true) @map("auto_learn")
  lastLearnAt   DateTime? @map("last_learn_at") @db.Timestamptz(3)
  /// Agenda por botones en el chat (el cliente toca el día y la hora).
  bookingEnabled Boolean  @default(true) @map("booking_enabled")
  bookingSiteId  String?  @map("booking_site_id") @db.Uuid
  slotMinutes    Int      @default(60) @map("slot_minutes")
  slotCapacity   Int      @default(1) @map("slot_capacity")
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@map("crm_ai_config")
}

enum AiGapStatus {
  PENDING
  ANSWERED
  DISMISSED
}

// Lo que le falta a la IA: datos del negocio que un cliente preguntó y la IA no sabía.
model AiGap {
  id        String      @id @default(uuid(7)) @db.Uuid
  companyId String      @map("company_id") @db.Uuid
  missing   String
  question  String?
  count     Int         @default(1)
  status    AiGapStatus @default(PENDING)
  answer    String?
  lastAt    DateTime    @default(now()) @map("last_at") @db.Timestamptz(3)
  createdAt DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)

  company Company @relation(fields: [companyId], references: [id], onDelete: Restrict)

  @@unique([companyId, missing])
  @@index([companyId, status])
  @@map("ai_gap")
}

enum TemplateStatus {
  DRAFT
  PENDING
  APPROVED
  REJECTED
  PAUSED
  DISABLED
}

// Plantilla de WhatsApp: se envía a Meta para aprobación y sirve para escribir
// fuera de la ventana de 24 h (retomar chats, recordatorios).
model WaTemplate {
  id           String         @id @default(uuid(7)) @db.Uuid
  companyId    String         @map("company_id") @db.Uuid
  name         String
  language     String         @default("es")
  category     String
  body         String
  examples     String[]       @default([])
  buttons      String[]       @default([])
  status       TemplateStatus @default(DRAFT)
  metaId       String?        @map("meta_id")
  rejectReason String?        @map("reject_reason")
  createdAt    DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime       @updatedAt @map("updated_at") @db.Timestamptz(3)

  company Company @relation(fields: [companyId], references: [id], onDelete: Restrict)

  @@unique([companyId, name, language])
  @@map("wa_template")
}

// ─────────────────────────── Entrar con Face ID o huella ───────────────────────────

// Desafío WebAuthn para entrar con Face ID o huella sin sesión previa.
// id = SHA-256 del token de una cookie de corta vida; un solo uso.
model PasskeyLogin {
  id        String   @id
  challenge String
  expiresAt DateTime @map("expires_at") @db.Timestamptz(3)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([expiresAt])
  @@map("passkey_login")
}

// ─────────────────────────── Comentarios de redes ───────────────────────────

// Comentario en una publicación o anuncio de Facebook o Instagram de la empresa.
// La IA lo clasifica y sugiere la respuesta; una persona responde en público,
// por privado (abre un chat) o lo descarta.
model SocialComment {
  id           String    @id @default(uuid(7)) @db.Uuid
  companyId    String    @map("company_id") @db.Uuid
  /// FACEBOOK o INSTAGRAM
  channel      String
  externalId   String    @map("external_id")
  parentId     String?   @map("parent_id")
  postId       String?   @map("post_id")
  postText     String?   @map("post_text")
  postUrl      String?   @map("post_url")
  authorId     String?   @map("author_id")
  authorName   String?   @map("author_name")
  body         String
  /// PENDING, REPLIED (en público), PRIVATE (por mensaje privado), IGNORED
  status       String    @default("PENDING")
  /// interes, elogio, negativo, otro
  aiType       String?   @map("ai_type")
  aiSuggestion String?   @map("ai_suggestion")
  aiPrivate    String?   @map("ai_private")
  aiError      String?   @map("ai_error")
  reply        String?
  repliedAt    DateTime? @map("replied_at") @db.Timestamptz(3)
  repliedById  String?   @map("replied_by_id") @db.Uuid
  demo         Boolean   @default(false)
  postedAt     DateTime  @map("posted_at") @db.Timestamptz(3)
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  company Company @relation(fields: [companyId], references: [id], onDelete: Restrict)

  @@unique([companyId, externalId])
  @@index([companyId, status, postedAt])
  @@map("social_comment")
}

// ─────────────────────────── Agenda de citas del CRM ───────────────────────────

// Cita con un cliente (agendada desde el chat con botones, por la IA o a mano).
model Appointment {
  id             String    @id @default(uuid(7)) @db.Uuid
  companyId      String    @map("company_id") @db.Uuid
  customerId     String    @map("customer_id") @db.Uuid
  siteId         String?   @map("site_id") @db.Uuid
  conversationId String?   @map("conversation_id") @db.Uuid
  startsAt       DateTime  @map("starts_at") @db.Timestamptz(3)
  durationMin    Int       @default(60) @map("duration_min")
  /// BOOKED, CONFIRMED, ATTENDED, NO_SHOW, CANCELLED
  status         String    @default("BOOKED")
  /// CHAT (botones), AI (la IA), MANUAL
  source         String    @default("MANUAL")
  notes          String?
  createdById    String?   @map("created_by_id") @db.Uuid
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  company  Company  @relation(fields: [companyId], references: [id], onDelete: Restrict)
  customer Customer @relation(fields: [customerId, companyId], references: [id, companyId], onDelete: Restrict)

  @@index([companyId, startsAt])
  @@index([companyId, customerId])
  @@map("appointment")
}

// Versión de lo que sabe la IA de mensajes (cada cambio: a mano, al enseñarle,
// en el aprendizaje diario o al volver atrás). Permite volver a cualquier versión.
model CrmAiVersion {
  id           String   @id @default(uuid(7)) @db.Uuid
  companyId    String   @map("company_id") @db.Uuid
  knowledge    String
  instructions String
  escalation   String
  /// manual, teach, learn (aprendizaje diario), revert
  source       String
  /// Informe del aprendizaje: qué vio y qué cambió.
  summary      String?
  metrics      Json?
  changes      Json?
  createdById  String?  @map("created_by_id") @db.Uuid
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  company Company @relation(fields: [companyId], references: [id], onDelete: Restrict)

  @@index([companyId, createdAt])
  @@map("crm_ai_version")
}

// ─────────────────────────── Punto de venta (POS) ───────────────────────────

// Categoría del catálogo visual del punto de venta. Sin padre: categoría
// (p. ej. «Hilos»); con padre: subcategoría (p. ej. «Hilos de crochet»).
model PosCategory {
  id        String   @id @default(uuid(7)) @db.Uuid
  companyId String   @map("company_id") @db.Uuid
  parentId  String?  @map("parent_id") @db.Uuid
  name      String
  /// Color del cuadro (hex) e ícono dibujado (yarn, crochet, needles, embroidery, accessories, box).
  color     String   @default("#6366F1")
  icon      String   @default("box")
  imageUrl  String?  @map("image_url")
  sortOrder Int      @default(0) @map("sort_order")
  active    Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  company  Company       @relation(fields: [companyId], references: [id], onDelete: Restrict)
  parent   PosCategory?  @relation("PosCategoryTree", fields: [parentId, companyId], references: [id, companyId], onDelete: Restrict)
  children PosCategory[] @relation("PosCategoryTree")
  products Product[]

  @@unique([id, companyId])
  @@index([companyId, parentId])
  @@map("pos_category")
}
