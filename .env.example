# Conexión a PostgreSQL (obligatoria).
# En local: postgresql://USUARIO:CLAVE@localhost:5432/nexora
# En Vercel + Supabase: cadena del "Transaction pooler" (puerto 6543).
DATABASE_URL="postgresql://USUARIO:CLAVE@HOST:5432/nexora"

# URL pública de la aplicación (opcional en local).
# Se imprime en los QR y las passkeys verifican el origen EXACTO: defínala solo
# cuando sea el dominio definitivo (p. ej. https://asistencia.miempresa.com).
# Sin ella, Nexora usa el dominio desde el que se abre la app.
# APP_URL="https://asistencia.miempresa.com"
