# Conexión a PostgreSQL (obligatoria)
DATABASE_URL="postgresql://USUARIO:CLAVE@HOST:5432/nexora?schema=public"
# Secreto para firmar tokens de QR y sesiones. Mínimo 32 caracteres aleatorios.
